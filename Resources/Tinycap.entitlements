<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store build as is: no network and no Movies folder. The direct build adds
	     the Movies folder (its default save folder), network access (update checks and
	     downloads) and Sparkle's mach-lookup exceptions in scripts/build-app.sh. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The save folder the user picks in the standard open panel, and Export As. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remembers the picked save folder across launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Microphone in recordings (AU-2), both builds. System sound needs only Screen Recording. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- iPhone and iPad capture (DV-1): macOS lists connected devices as cameras. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
